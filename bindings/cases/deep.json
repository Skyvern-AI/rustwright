    {
      "id": "counter-control-loop",
      "description": "Drive a resettable counter through a dense sequence of button interactions.",
      "html": "<!doctype html><html><head><title>Counter Controls</title><style>button{margin:4px;padding:10px}#count{font:40px monospace}</style></head><body><main><h1>Capacity planner</h1><button id='reset'>Reset</button><button id='increment'>Increase</button><button id='decrement'>Decrease</button><output id='count'>0</output><section id='history'></section></main><script>const output=document.querySelector('#count');const history=document.querySelector('#history');function setCount(value){output.textContent=String(value);history.innerHTML+=('<span data-value=\\''+value+'\\'>'+value+'</span>');}document.querySelector('#reset').addEventListener('click',()=>{history.textContent='';setCount(0);});document.querySelector('#increment').addEventListener('click',()=>setCount(Number(output.textContent)+1));document.querySelector('#decrement').addEventListener('click',()=>setCount(Number(output.textContent)-1));</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "click", "selector": "#reset" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#increment" },
        { "op": "click", "selector": "#decrement" },
        { "op": "click", "selector": "#decrement" },
        { "op": "textContent", "selector": "#count", "capture": "count" },
        { "op": "assertText", "selector": "#count", "equals": "10" },
        { "op": "evaluate", "expression": "()=>({count:Number(document.querySelector('#count').textContent),events:document.querySelectorAll('#history span').length})", "capture": "counterState" },
        { "op": "assertEval", "expression": "({count:Number(document.querySelector('#count').textContent),events:document.querySelectorAll('#history span').length})", "equals": { "count": 10, "events": 15 } }
      ]
    },
    {
      "id": "tab-navigation-loop",
      "description": "Navigate a large in-page tab workspace repeatedly and assert the selected panel.",
      "html": "<!doctype html><html><head><title>Tab Workspace</title><style>[role=tab]{padding:8px}.panel[hidden]{display:none}.panel{padding:16px;border:1px solid #888}</style></head><body><main><h1>Operations workspace</h1><nav id='tabs' role='tablist'></nav><div id='panels'></div><output id='active'></output></main><script>const tabs=document.querySelector('#tabs');const panels=document.querySelector('#panels');tabs.innerHTML=Array.from({length:8},(_,index)=>'<button id=\\'tab-'+index+'\\' role=\\'tab\\'>Section '+index+'</button>').join('');panels.innerHTML=Array.from({length:8},(_,index)=>'<section id=\\'panel-'+index+'\\' class=\\'panel\\'>'+Array.from({length:40},(_,row)=>'<p>Panel '+index+' deterministic content '+row+'</p>').join('')+'</section>').join('');function select(index){document.querySelectorAll('[role=tab]').forEach((tab,item)=>tab.setAttribute('aria-selected',String(item===index)));document.querySelectorAll('.panel').forEach((panel,item)=>panel.hidden=item!==index);document.querySelector('#active').textContent='active:panel-'+index;}tabs.addEventListener('click',event=>select(Number(event.target.id.split('-')[1])));select(0);</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "click", "selector": "#tab-1" },
        { "op": "click", "selector": "#tab-4" },
        { "op": "click", "selector": "#tab-2" },
        { "op": "click", "selector": "#tab-7" },
        { "op": "textContent", "selector": "#active", "capture": "activePanel" },
        { "op": "assertText", "selector": "#active", "equals": "active:panel-7" },
        { "op": "evaluate", "expression": "()=>({selected:document.querySelector('[aria-selected=true]').id,visible:document.querySelector('.panel:not([hidden])').id})", "capture": "tabState" },
        { "op": "assertEval", "expression": "({selected:document.querySelector('[aria-selected=true]').id,visible:document.querySelector('.panel:not([hidden])').id})", "equals": { "selected": "tab-7", "visible": "panel-7" } }
      ]
    },
    {
      "id": "accordion-navigation-loop",
      "description": "Toggle several nested accordion sections and verify the deterministic open set.",
      "html": "<!doctype html><html><head><title>Accordion Workspace</title><style>section{border:1px solid #aaa;margin:6px;padding:6px}.body[hidden]{display:none}</style></head><body><main><h1>Runbook library</h1><button id='collapse-all'>Collapse all</button><div id='accordions'></div><output id='summary'></output></main><script>const root=document.querySelector('#accordions');root.innerHTML=Array.from({length:8},(_,index)=>'<section id=\\'acc-'+index+'\\'><button class=\\'toggle\\' data-index=\\''+index+'\\'>Runbook '+index+'</button><div class=\\'body\\' hidden>'+Array.from({length:25},(_,row)=>'<p>Procedure '+index+'.'+row+'</p>').join('')+'</div></section>').join('');function update(){const open=Array.from(document.querySelectorAll('section')).filter(section=>!section.querySelector('.body').hidden).map(section=>section.id);document.querySelector('#summary').textContent='open:'+open.length+':'+open.join(',');}root.addEventListener('click',event=>{if(!event.target.classList.contains('toggle'))return;const body=event.target.nextElementSibling;body.hidden=!body.hidden;update();});document.querySelector('#collapse-all').addEventListener('click',()=>{document.querySelectorAll('.body').forEach(body=>body.hidden=true);update();});update();</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "click", "selector": "#collapse-all" },
        { "op": "click", "selector": "#acc-1 .toggle" },
        { "op": "click", "selector": "#acc-3 .toggle" },
        { "op": "click", "selector": "#acc-5 .toggle" },
        { "op": "click", "selector": "#acc-3 .toggle" },
        { "op": "textContent", "selector": "#summary", "capture": "accordionSummary" },
        { "op": "assertText", "selector": "#summary", "equals": "open:2:acc-1,acc-5" },
        { "op": "evaluate", "expression": "()=>Array.from(document.querySelectorAll('section')).filter(section=>!section.querySelector('.body').hidden).map(section=>section.id)", "capture": "openAccordions" },
        { "op": "assertEval", "expression": "Array.from(document.querySelectorAll('section')).filter(section=>!section.querySelector('.body').hidden).map(section=>section.id)", "equals": ["acc-1", "acc-5"] }
      ]
    },
    {
      "id": "large-table-evaluate",
      "description": "Run repeated aggregate computations over a deterministic 400-row ledger.",
      "html": "<!doctype html><html><head><title>Ledger Aggregate</title><style>table{border-collapse:collapse}td,th{padding:3px 8px;border:1px solid #ccc}</style></head><body><main><h1>Regional ledger</h1><table id='ledger'><thead><tr><th>ID</th><th>Region</th><th>Amount</th></tr></thead><tbody></tbody></table></main><script>document.querySelector('#ledger tbody').innerHTML=Array.from({length:400},(_,index)=>'<tr data-region=\\'r'+index%5+'\\'><td>TX-'+String(index).padStart(4,'0')+'</td><td>r'+index%5+'</td><td class=\\'amount\\'>'+((index%25)+1)+'</td></tr>').join('');</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "evaluate", "expression": "()=>{const rows=Array.from(document.querySelectorAll('#ledger tbody tr'));const amounts=rows.map(row=>Number(row.querySelector('.amount').textContent));return {rows:rows.length,total:amounts.reduce((sum,value)=>sum+value,0),high:amounts.filter(value=>value>=20).length};}", "capture": "aggregate" },
        { "op": "evaluate", "expression": "()=>Object.fromEntries(Array.from({length:5},(_,index)=>['r'+index,document.querySelectorAll('tr[data-region=r'+index+']').length]))", "capture": "regions" },
        { "op": "evaluate", "expression": "()=>Array.from(document.querySelectorAll('#ledger tbody tr')).reduce((sum,row,index)=>sum+Number(row.children[2].textContent)*(index+1),0)", "capture": "weightedChecksum" },
        { "op": "assertEval", "expression": "(()=>{const rows=Array.from(document.querySelectorAll('#ledger tbody tr'));const amounts=rows.map(row=>Number(row.querySelector('.amount').textContent));return {rows:rows.length,total:amounts.reduce((sum,value)=>sum+value,0),high:amounts.filter(value=>value>=20).length};})()", "equals": { "rows": 400, "total": 5200, "high": 96 } },
        { "op": "assertEval", "expression": "Object.fromEntries(Array.from({length:5},(_,index)=>['r'+index,document.querySelectorAll('tr[data-region=r'+index+']').length]))", "equals": { "r0": 80, "r1": 80, "r2": 80, "r3": 80, "r4": 80 } }
      ]
    },
    {
      "id": "nested-dom-evaluate",
      "description": "Traverse and summarize a deeply nested 600-leaf document repeatedly.",
      "html": "<!doctype html><html><head><title>Nested Inventory</title><style>.group{margin-left:8px}.leaf{display:inline-block;width:70px}</style></head><body><main><h1>Nested inventory</h1><div id='inventory'></div></main><script>document.querySelector('#inventory').innerHTML=Array.from({length:12},(_,section)=>'<section data-section=\\''+section+'\\'><h2>Section '+section+'</h2>'+Array.from({length:10},(_,group)=>'<div class=\\'group\\' data-group=\\''+group+'\\'>'+Array.from({length:5},(_,leaf)=>'<span class=\\'leaf\\' data-value=\\''+(section*100+group*10+leaf)+'\\'>I-'+section+'-'+group+'-'+leaf+'</span>').join('')+'</div>').join('')+'</section>').join('');</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "evaluate", "expression": "()=>{const leaves=Array.from(document.querySelectorAll('.leaf'));return {sections:document.querySelectorAll('#inventory>section').length,groups:document.querySelectorAll('.group').length,leaves:leaves.length,last:leaves.at(-1).textContent};}", "capture": "treeShape" },
        { "op": "evaluate", "expression": "()=>Array.from(document.querySelectorAll('.leaf')).reduce((sum,node)=>sum+Number(node.dataset.value),0)", "capture": "treeChecksum" },
        { "op": "assertEval", "expression": "(()=>{const leaves=Array.from(document.querySelectorAll('.leaf'));return {sections:document.querySelectorAll('#inventory>section').length,groups:document.querySelectorAll('.group').length,leaves:leaves.length,last:leaves.at(-1).textContent};})()", "equals": { "sections": 12, "groups": 120, "leaves": 600, "last": "I-11-9-4" } },
        { "op": "assertText", "selector": "#inventory", "contains": "I-11-9-4" }
      ]
    },
    {
      "id": "large-table-text-extraction",
      "description": "Extract text repeatedly from a 300-row account table and assert its tail row.",
      "html": "<!doctype html><html><head><title>Account Directory</title><style>table{width:100%}tr:nth-child(even){background:#eee}</style></head><body><main><h1>Account directory</h1><table id='accounts'><thead><tr><th>Account</th><th>Region</th><th>Balance</th></tr></thead><tbody></tbody></table></main><script>const regions=['North','South','East','West'];document.querySelector('#accounts tbody').innerHTML=Array.from({length:300},(_,index)=>'<tr id=\\'account-'+String(index).padStart(4,'0')+'\\'><td>Account '+String(index).padStart(4,'0')+'</td><td>'+regions[index%4]+'</td><td>'+index*3+'</td></tr>').join('');</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "textContent", "selector": "#accounts tbody", "capture": "accountTableText" },
        { "op": "textContent", "selector": "#account-0299", "capture": "lastAccount" },
        { "op": "assertText", "selector": "#accounts tbody", "contains": "Account 0299" },
        { "op": "assertText", "selector": "#account-0299", "equals": "Account 0299West897" },
        { "op": "assertEval", "expression": "document.querySelectorAll('#accounts tbody tr').length", "equals": 300 }
      ]
    },
    {
      "id": "attribute-read-matrix",
      "description": "Read and summarize several attributes across 240 asset cards.",
      "html": "<!doctype html><html><head><title>Asset Matrix</title><style>#assets{display:grid;grid-template-columns:repeat(6,1fr);gap:4px}.asset{padding:6px;border:1px solid #bbb}</style></head><body><main><h1>Asset matrix</h1><div id='assets'></div></main><script>document.querySelector('#assets').innerHTML=Array.from({length:240},(_,index)=>'<article class=\\'asset\\' data-id=\\'asset-'+String(index).padStart(4,'0')+'\\' data-tier=\\''+(index%3===0?'premium':'standard')+'\\' aria-label=\\'Asset '+String(index).padStart(4,'0')+'\\' title=\\'Owner '+index%12+'\\'><span>Asset '+index+'</span></article>').join('');</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "evaluate", "expression": "()=>{const cards=Array.from(document.querySelectorAll('.asset'));return {count:cards.length,premium:cards.filter(card=>card.getAttribute('data-tier')==='premium').length,last:cards.at(-1).getAttribute('data-id'),labels:[cards[0].getAttribute('aria-label'),cards.at(-1).getAttribute('aria-label')],owners:new Set(cards.map(card=>card.getAttribute('title'))).size};}", "capture": "attributeSummary" },
        { "op": "evaluate", "expression": "()=>Array.from(document.querySelectorAll('.asset')).slice(0,20).map(card=>({id:card.dataset.id,tier:card.dataset.tier,label:card.getAttribute('aria-label')}))", "capture": "attributeSample" },
        { "op": "assertEval", "expression": "(()=>{const cards=Array.from(document.querySelectorAll('.asset'));return {count:cards.length,premium:cards.filter(card=>card.getAttribute('data-tier')==='premium').length,last:cards.at(-1).getAttribute('data-id'),labels:[cards[0].getAttribute('aria-label'),cards.at(-1).getAttribute('aria-label')],owners:new Set(cards.map(card=>card.getAttribute('title'))).size};})()", "equals": { "count": 240, "premium": 80, "last": "asset-0239", "labels": ["Asset 0000", "Asset 0239"], "owners": 12 } }
      ]
    },
    {
      "id": "title-text-assert-mix",
      "description": "Mix title reads, large-document text extraction, evaluate captures, and exact assertions.",
      "html": "<!doctype html><html><head><title>Quarterly Operations Review</title><style>section{padding:4px;border-bottom:1px solid #ddd}</style></head><body><main><h1 id='heading'>Quarterly Operations Review</h1><article id='report'></article><footer id='footer'>Prepared deterministically</footer></main><script>document.querySelector('#report').innerHTML=Array.from({length:120},(_,index)=>'<section data-index=\\''+index+'\\'><h2>Division '+String(index).padStart(3,'0')+'</h2><p>Revenue '+index*17+' units; status '+(index%2?'stable':'growing')+'.</p></section>').join('');</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "title", "capture": "reviewTitle" },
        { "op": "textContent", "selector": "#heading", "capture": "reviewHeading" },
        { "op": "textContent", "selector": "#report section:last-child", "capture": "lastDivision" },
        { "op": "assertTitle", "equals": "Quarterly Operations Review" },
        { "op": "assertTitle", "contains": "Operations" },
        { "op": "assertText", "selector": "#heading", "equals": "Quarterly Operations Review" },
        { "op": "assertText", "selector": "#report", "contains": "Division 119" },
        { "op": "evaluate", "expression": "()=>({sections:document.querySelectorAll('#report section').length,growing:document.querySelectorAll('#report section:nth-child(odd)').length,footer:document.querySelector('#footer').textContent})", "capture": "reviewSummary" },
        { "op": "assertEval", "expression": "({sections:document.querySelectorAll('#report section').length,growing:document.querySelectorAll('#report section:nth-child(odd)').length,footer:document.querySelector('#footer').textContent})", "equals": { "sections": 120, "growing": 60, "footer": "Prepared deterministically" } }
      ]
    },
    {
      "id": "dashboard-filter-workflow",
      "description": "Fill and apply a deterministic filter over 250 dashboard records.",
      "html": "<!doctype html><html><head><title>Task Dashboard</title><style>#tasks{display:grid;grid-template-columns:repeat(5,1fr);gap:4px}.task{border:1px solid #aaa;padding:5px}.task[hidden]{display:none}</style></head><body><main><h1>Task dashboard</h1><label>Filter <input id='query'></label><button id='apply'>Apply filter</button><output id='matches'>matches:250</output><section id='tasks'></section></main><script>const root=document.querySelector('#tasks');root.innerHTML=Array.from({length:250},(_,index)=>'<article class=\\'task\\' data-priority=\\'priority-'+index%5+'\\'><h2>Task '+String(index).padStart(3,'0')+'</h2><p>priority-'+index%5+' owner-'+index%10+'</p></article>').join('');document.querySelector('#apply').addEventListener('click',()=>{const query=document.querySelector('#query').value.toLowerCase();let matches=0;document.querySelectorAll('.task').forEach(task=>{task.hidden=!task.textContent.toLowerCase().includes(query);if(!task.hidden)matches++;});document.querySelector('#matches').textContent='matches:'+matches;});</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "fill", "selector": "#query", "value": "priority-0" },
        { "op": "click", "selector": "#apply" },
        { "op": "textContent", "selector": "#matches", "capture": "matchSummary" },
        { "op": "assertText", "selector": "#matches", "equals": "matches:50" },
        { "op": "evaluate", "expression": "()=>Array.from(document.querySelectorAll('.task')).filter(task=>!task.hidden).length", "capture": "visibleTasks" },
        { "op": "assertEval", "expression": "Array.from(document.querySelectorAll('.task')).filter(task=>!task.hidden).length", "equals": 50 },
        { "op": "assertText", "selector": "#tasks", "contains": "Task 245" }
      ]
    },
    {
      "id": "record-detail-navigation",
      "description": "Navigate repeatedly among 200 in-page records and assert the final detail state.",
      "html": "<!doctype html><html><head><title>Record Explorer</title><style>#records{height:240px;overflow:auto;display:grid;grid-template-columns:repeat(5,1fr)}#detail{padding:12px;border:2px solid #555}</style></head><body><main><h1>Record explorer</h1><button id='reset'>Reset selection</button><nav id='records'></nav><article id='detail'><h2>Nothing selected</h2><p id='detail-text'>Choose a record</p></article></main><script>const records=document.querySelector('#records');records.innerHTML=Array.from({length:200},(_,index)=>'<button id=\\'record-'+String(index).padStart(3,'0')+'\\' data-index=\\''+index+'\\'>Record '+String(index).padStart(3,'0')+'</button>').join('');function reset(){document.querySelector('#detail h2').textContent='Nothing selected';document.querySelector('#detail-text').textContent='Choose a record';document.body.dataset.selected='';document.body.dataset.visits='0';}records.addEventListener('click',event=>{const index=Number(event.target.dataset.index);document.querySelector('#detail h2').textContent='Record '+String(index).padStart(3,'0');document.querySelector('#detail-text').textContent='Owner '+index%10+'; score '+index*7;document.body.dataset.selected=String(index);document.body.dataset.visits=String(Number(document.body.dataset.visits)+1);});document.querySelector('#reset').addEventListener('click',reset);reset();</script></body></html>",
      "repeat": 25,
      "steps": [
        { "op": "goto", "useCaseHtml": true },
        { "op": "click", "selector": "#reset" },
        { "op": "click", "selector": "#record-001" },
        { "op": "click", "selector": "#record-125" },
        { "op": "click", "selector": "#record-199" },
        { "op": "textContent", "selector": "#detail h2", "capture": "selectedRecord" },
        { "op": "textContent", "selector": "#detail-text", "capture": "recordDetail" },
        { "op": "assertText", "selector": "#detail h2", "equals": "Record 199" },
        { "op": "assertText", "selector": "#detail-text", "equals": "Owner 9; score 1393" },
        { "op": "evaluate", "expression": "()=>({selected:document.body.dataset.selected,visits:Number(document.body.dataset.visits)})", "capture": "recordState" },
        { "op": "assertEval", "expression": "({selected:document.body.dataset.selected,visits:Number(document.body.dataset.visits)})", "equals": { "selected": "199", "visits": 3 } }
      ]
    },
    {
      "id": "navigation-reload-cycle",
      "description": "Exercise a navigation-heavy block that mutates a report and then reloads the case HTML.",
      "html": "<!doctype html><html><head><title>Deep Navigation Home</title><style>#catalog{display:grid;grid-template-columns:repeat(6,1fr)}.item{padding:5px}</style></head><body><main><h1 id='view'>Research home</h1><button id='open-report'>Open report</button><div id='catalog'></div><article id='report'>No report open</article></main><script>document.querySelector('#catalog').innerHTML=Array.from({length:180},(_,index)=>'<div class=\\'item\\' data-code=\\'R-'+String(index).padStart(3,'0')+'\\'>Research item '+index+'</div>').join('');document.querySelector('#open-report').addEventListener('click',()=>{document.title='Deep Navigation Detail';document.querySelector('#view').textContent='Report detail';document.querySelector('#report').textContent='Revenue $4.2M; risk low; records 180';document.body.dataset.view='detail';});</script></body></html>",
      "repeat": 5,
      "steps": [
        { "op": "goto", "useCaseHtml": true, "waitUntil": "load" },
        { "op": "click", "selector": "#open-report" },
        { "op": "assertText", "selector": "#view", "equals": "Report detail" },
        { "op": "assertText", "selector": "#report", "contains": "records 180" },
        { "op": "title", "capture": "detailTitle" },
        { "op": "assertTitle", "equals": "Deep Navigation Detail" },
        { "op": "evaluate", "expression": "()=>({view:document.body.dataset.view,items:document.querySelectorAll('.item').length})", "capture": "detailState" },
        { "op": "goto", "useCaseHtml": true, "waitUntil": "load" },
        { "op": "assertText", "selector": "#view", "equals": "Research home" },
        { "op": "assertTitle", "equals": "Deep Navigation Home" }
      ]
    }
  ]
}
